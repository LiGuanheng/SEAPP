{
  "name": "last-light-api",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/index.ts",
    "build": "tsc && node scripts/copy-sql.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/server/src/index.js",
    "migrate": "node --env-file-if-exists=.env --experimental-strip-types src/migrate.ts",
    "seed": "node --env-file-if-exists=.env --experimental-strip-types src/migrate.ts --seed",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.test --experimental-strip-types --test tests/*.integration.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "10.3.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
