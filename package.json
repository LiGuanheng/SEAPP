{
  "name": "the-last-light",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:legacy": "node --experimental-strip-types --test legacy/v0.1/tests/*.test.ts",
    "test:e2e": "playwright test",
    "simulate:night": "node --experimental-strip-types scripts/simulate-night.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
