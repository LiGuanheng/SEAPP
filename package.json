{
  "name": "the-last-light",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:legacy": "node --experimental-strip-types --test legacy/v0.1/tests/*.test.ts",
    "test:e2e": "playwright test",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "test:server": "npm --prefix server test",
    "test:db": "npm --prefix server run test:integration",
    "simulate:night": "node --experimental-strip-types scripts/simulate-night.mjs",
    "simulate:progression": "node --experimental-strip-types scripts/simulate-progression.mjs",
    "measure:base": "node scripts/measure-base-performance.mjs",
    "simulate:siege": "node --experimental-strip-types scripts/validate-siege.mjs",
    "capture:siege": "node scripts/capture-siege.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
